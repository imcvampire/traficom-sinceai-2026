# ITU Space IFIC source watcher (see docs/source-watcher.md)
# Master switch. false stops the watcher and locks the UI toggle.
IFIC_WATCHER_ENABLED=true
# Seconds between scheduled checks (minimum 60).
IFIC_WATCHER_INTERVAL_SECONDS=3600
IFIC_WATCHER_SOURCE_URL=https://www.itu.int/sns/wic/demowic.html
# Relative paths resolve against the repository root.
IFIC_WATCHER_DOWNLOAD_DIR=data/ific
IFIC_WATCHER_STATE_PATH=var/db/watcher.sqlite3
IFIC_WATCHER_HTTP_TIMEOUT_SECONDS=60
# Upper bound for one zip download and for its extracted .mdb files.
IFIC_WATCHER_MAX_DOWNLOAD_BYTES=2000000000

# Stations map basemap (see docs/frontend.md). Raster XYZ tile URL; the default is the public OSM tile server,
# whose usage policy allows light use with attribution. Vite reads VITE_* variables at build time.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
